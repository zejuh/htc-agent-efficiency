OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 可选运行控制。
OBSERVATION_MODE=dom
SOA_MAX_STEPS=16
SOA_COLLECT_ROUNDS=1
SOA_TAUS=0.2,0.35,0.5,0.65,0.8,0.9,0.95
SOA_DAGGER_ROUNDS=1
SOA_DAGGER_TAU=0.5
SOA_GATE_LEARNER=auto

# 可选任务过滤。
# SOA_SUITE=tasks/tasks.json
# SOA_FAMILY=value_drift
# SOA_DIFFICULTY=adversarial
# SOA_MAX_TASKS=5

# 可选 MiniWoB 支持。指向官方 MiniWoB HTML 根目录；
# 该目录应包含 miniwob/、core/ 和 common/ 子目录。
# SOA_MINIWOB_HTML_ROOT=
